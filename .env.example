CONFIG_CENTER_ADDR=:9313
# Production must be a real public HTTPS URL. Windows local integration can use a tunnel HTTPS URL.
CONFIG_CENTER_BASE_URL=https://config-service.baichengedu.com

PG_HOST=127.0.0.1
PG_PORT=5432
PG_ADMIN=postgres
PG_ADMIN_SECRET=change-me

CONFIG_CENTER_DB_NAME=config_center
CONFIG_CENTER_DB_USER=config_center
CONFIG_CENTER_DB_PASSWORD=

AUTH_LIMIT_BASE_URL=https://auth-limit.baichengedu.com
AUTH_LIMIT_ADMIN=
AUTH_LIMIT_ADMIN_SECRET=
# auth-limit 用户名必须为 3-20 位字母、数字或下划线；密码必须为 8-20 位且包含大小写、数字和特殊字符。
AUTH_LIMIT_OPERATOR_USERNAME=cfgcenter_ops
AUTH_LIMIT_OPERATOR_PASSWORD=
AUTH_LIMIT_OPERATOR_DISPLAY_NAME=Config Center Operator
AUTH_LIMIT_OPERATOR_ROLE_CODE=config_center_operator
AUTH_LIMIT_OPERATOR_ROLE_NAME=Config Center Operator
AUTH_LIMIT_SERVICE_CODE=config-service-baichengedu
AUTH_LIMIT_SERVICE_NAME=Config Center Production
AUTH_LIMIT_APP_NAME=config-service-baichengedu
AUTH_LIMIT_SERVICE_ID=
AUTH_LIMIT_APP_ID=
AUTH_LIMIT_APP_SECRET=

# Only for isolated local tests that do not call remote auth-limit service registration.
ALLOW_LOCAL_SERVICE_URL=false
